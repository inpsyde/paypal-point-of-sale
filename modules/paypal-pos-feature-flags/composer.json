{
    "name": "inpsyde\/paypal-pos-feature-flags",
    "type": "inpsyde-module",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https:\/\/repo.packagist.com\/inpsyde\/"
        },
        {
            "type": "path",
            "url": "..\/inpsyde-wc-status-report"
        }
    ],
    "require": {
        "php": "^8.2",
        "inpsyde\/feature-flags": "^2.1",
        "inpsyde\/modularity": "^1.7",
        "inpsyde\/wc-status-report": "*",
        "psr\/container": "^1.1 || ^2.0",
        "psr\/http-client": "^1.0",
        "psr\/http-factory": "^1.0",
        "psr\/log": "^1.1 || ^2.0 || ^3.0",
        "unleash\/client": "^2.5"
    },
    "require-dev": {
        "brain\/monkey": "^2.0",
        "mockery\/mockery": "^1.3",
        "phpunit\/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Syde\\Vendor\\Zettle\\Syde\\PayPal\\PointOfSale\\FeatureFlags\\": "src\/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Syde\\Vendor\\Zettle\\Syde\\PayPal\\PointOfSale\\FeatureFlags\\Tests\\": "tests\/PHPUnit"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http\/discovery": false
        }
    }
}