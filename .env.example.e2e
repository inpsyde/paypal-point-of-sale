# Copy this file to .env and fill in real values for local development
# Never commit .env — it is gitignored

# Site (wp-env default)
WP_BASE_URL=http://localhost:8100
WP_USERNAME=admin
WP_PASSWORD=password

# Storage states
STORAGE_STATE_PATH=./storage-states
STORAGE_STATE_PATH_ADMIN=./storage-states/admin.json

# CLI — wp-env for local development
WPCLI_ENV_TYPE=wpenv

# PayPal POS sandbox API key
PAYPAL_POS_API_KEY=

# WooCommerce REST API — populated automatically by `npm run e2e:env:reset` if left empty
WC_API_KEY=
WC_API_SECRET=

# Country/currency applied to WooCommerce by `npm run e2e:env:reset` (see shopSettings in
# @inpsyde/playwright-utils for available keys). MUST match the market the PayPal POS
# sandbox account is configured for, or synced prices/totals won't be comparable.
# Defaults to "uk" — PayPal POS does not sync US tax rates, so "usa" would leave tax sync
# effectively unverified.
# WC_DEFAULT_COUNTRY=uk

# ── Remote / Kinsta — set WPCLI_ENV_TYPE=ssh to target a remote host ─────────
# WPCLI_ENV_TYPE=ssh
# SSH_LOGIN=username
# SSH_HOST=ssh.kinsta.cloud
# SSH_PORT=12345
# SSH_PATH=/www/paypal-pos.paypal.wpcust.cloud/public

# Used only by `npm run e2e:env:reset` against Kinsta (DevOps' reset-wp.sh) — optional,
# defaults to 7.0 / single if unset. Must satisfy WooCommerce's current minimum WP
# requirement (https://wordpress.org/plugins/woocommerce/) or plugin install fails after reset.
# WP_VERSION=7.0
# WP_TYPE=single

# HTTP basic auth — Kinsta staging enables this by default
# WP_BASIC_AUTH_USER=
# WP_BASIC_AUTH_PASS=
# IGNORE_HTTPS_ERRORS=false